# Public site
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Contact inbox
CONTACT_TO_EMAIL=you@example.com

# Transactional email: use either Resend or Brevo.
# The sender address must be verified with the provider.
NEWSLETTER_FROM_EMAIL=hello@your-domain.example
RESEND_API_KEY=
# RESEND_FROM_EMAIL=hello@your-domain.example
BREVO_API_KEY=

# Signed newsletter unsubscribe links
NEWSLETTER_TOKEN_SECRET=replace-with-a-long-random-secret

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
